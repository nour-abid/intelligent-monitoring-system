APP_NAME="MQ Monitoring API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8081

APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel's own SQLite DB (for framework internals if needed).
DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/laravel.sqlite

# ─── Surveillance analytics database ─────────────────────────────────────────
# Absolute or relative (from Laravel project root) path to the SQLite database
# file written by the Python surveillance runtime.
#
# Default resolves to:  <project-root>/logs/surveillance_events.db
# i.e. one directory above mq-monitoring-api/.
#
# On Windows use forward slashes or double back-slashes:
#   SURVEILLANCE_DB_PATH=C:/Users/BH RENOVATIONS/intelligent-monitoring-system/logs/surveillance_events.db
SURVEILLANCE_DB_PATH=

# ─── Internal surveillance token ──────────────────────────────────────────────
# Shared secret for the Python surveillance pipeline → Laravel clip metadata API.
# Must match clip_api_token in surveillance/config/settings.yaml exactly.
# Generate with:  php -r "echo bin2hex(random_bytes(32));"
SURVEILLANCE_INTERNAL_TOKEN=change-me-in-production
